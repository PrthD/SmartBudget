# --- Required -------------------------------------------------------------
# Local dev uses the Docker database from docker-compose.yml (`make db-up`).
MONGODB_URI=mongodb://127.0.0.1:27017/smartbudget_dev
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server ---------------------------------------------------------------
PORT=5000
# NODE_ENV=production   (enables Secure, cross-site refresh cookies)
# Reverse proxies in front of the app (Render: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=1
# LOG_LEVEL=info

# --- CORS: comma-separated list and/or the legacy single variables ---------
# CORS_ORIGINS=https://smartbudget-frontend.onrender.com
FRONTEND_DEV_ORIGIN=http://localhost:3000
FRONTEND_PROD_ORIGIN=
FRONTEND_CUSTOM_ORIGIN=

# --- Sessions ---------------------------------------------------------------
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie SameSite: "none" (+ Secure, Partitioned) in production, where
# the web app and API are different sites (two *.onrender.com hosts); "lax"
# elsewhere. Set "lax" in production only if both share a site (custom domain).
# COOKIE_SAMESITE=none

# --- AI (optional; features fall back to rule-based logic without it) ------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ordered fallback chain, tried left to right on quota/outage errors.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# AI_DAILY_REQUESTS_PER_USER=30
